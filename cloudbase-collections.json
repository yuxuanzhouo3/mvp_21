      "indexes": [
        {
          "name": "email_index",
          "keys": [{ "field": "email", "order": "asc" }],
          "unique": true
        },
        {
          "name": "subscription_status_index",
          "keys": [{ "field": "subscription_status", "order": "asc" }]
        },
        {
          "name": "created_at_index",
          "keys": [{ "field": "created_at", "order": "desc" }]
        }
      ],
      "schema": {
        "_id": "string",
        "email": "string",
        "password": "string",
        "name": "string",
        "avatar": "string",
        "phone": "string",
        "subscription_plan": "string",
