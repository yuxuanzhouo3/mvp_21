{
  "collections": [
    {
      "name": "web_users",
      "description": "用户主表",
      "indexes": [
        {
          "name": "email_index",
          "keys": [{ "field": "email", "order": "asc" }],
          "unique": true
        },
        {
          "name": "subscription_status_index",
          "keys": [{ "field": "subscription_status", "order": "asc" }]
        },
        {
          "name": "created_at_index",
          "keys": [{ "field": "created_at", "order": "desc" }]
        }
      ],
      "schema": {
        "_id": "string",
        "email": "string",
        "password": "string",
        "name": "string",
        "avatar": "string",
        "phone": "string",
        "subscription_plan": "string",
        "subscription_status": "string",
        "membership_expires_at": "date",
        "preferences": "object",
        "region": "string",
        "created_at": "date",
        "updated_at": "date"
      }
    },
    {
      "name": "company_profiles",
      "description": "企业档案表",
      "indexes": [
        {
          "name": "user_id_unique_index",
          "keys": [{ "field": "user_id", "order": "asc" }],
          "unique": true
        }
      ],
      "schema": {
        "_id": "string",
        "user_id": "string",
        "company_name": "string",
        "credit_code": "string",
        "legal_person": "string",
        "address": "string",
        "contact_person": "string",
        "contact_phone": "string",
        "contact_email": "string",
        "created_at": "date",
        "updated_at": "date"
      }
    },
    {
      "name": "contracts",
      "description": "合同表",
      "indexes": [
        {
          "name": "user_id_index",
          "keys": [{ "field": "user_id", "order": "asc" }]
        },
        {
          "name": "status_index",
          "keys": [{ "field": "status", "order": "asc" }]
        },
        {
          "name": "created_at_index",
          "keys": [{ "field": "created_at", "order": "desc" }]
        }
      ],
      "schema": {
        "_id": "string",
        "user_id": "string",
        "title": "string",
        "type": "string",
        "status": "string",
        "content": "object",
        "source_type": "string",
        "source_content": "string",
        "analysis_result": "object",
        "parties": "array",
        "signatures": "array",
        "metadata": "object",
        "region": "string",
        "created_at": "date",
        "updated_at": "date"
      }
    },
    {
      "name": "subscriptions",
      "description": "订阅表",
      "indexes": [
        {
          "name": "user_id_index",
          "keys": [{ "field": "user_id", "order": "asc" }]
        },
        {
          "name": "status_index",
          "keys": [{ "field": "status", "order": "asc" }]
        }
      ],
      "schema": {
        "_id": "string",
        "user_id": "string",
        "plan": "string",
        "plan_id": "string",
        "status": "string",
        "price": "number",
        "currency": "string",
        "billing_cycle": "string",
        "payment_method": "string",
        "current_period_end": "date",
        "metadata": "object",
        "region": "string",
        "created_at": "date",
        "updated_at": "date"
      }
    },
    {
      "name": "payments",
      "description": "支付表",
      "indexes": [
        {
          "name": "user_id_index",
          "keys": [{ "field": "user_id", "order": "asc" }]
        },
        {
          "name": "subscription_id_index",
          "keys": [{ "field": "subscription_id", "order": "asc" }]
        },
        {
          "name": "status_index",
          "keys": [{ "field": "status", "order": "asc" }]
        }
      ],
      "schema": {
        "_id": "string",
        "user_id": "string",
        "subscription_id": "string",
        "amount": "number",
        "currency": "string",
        "payment_method": "string",
        "status": "string",
        "transaction_id": "string",
        "metadata": "object",
        "region": "string",
        "created_at": "date",
        "updated_at": "date"
      }
    },
    {
      "name": "refresh_tokens",
      "description": "刷新令牌表",
      "indexes": [
        {
          "name": "token_id_index",
          "keys": [{ "field": "tokenId", "order": "asc" }],
          "unique": true
        },
        {
          "name": "user_id_created_at_index",
          "keys": [
            { "field": "userId", "order": "asc" },
            { "field": "createdAt", "order": "desc" }
          ]
        }
      ],
      "schema": {
        "_id": "string",
        "tokenId": "string",
        "userId": "string",
        "email": "string",
        "refreshToken": "string",
        "deviceInfo": "string",
        "ipAddress": "string",
        "userAgent": "string",
        "isRevoked": "boolean",
        "revokedAt": "date",
        "revokeReason": "string",
        "createdAt": "date",
        "expiresAt": "date",
        "lastUsedAt": "date",
        "usageCount": "number",
        "region": "string"
      }
    }
  ],
  "instructions": "请在 CloudBase 控制台中按以上集合名创建集合和索引。当前前后端统一以 web_users、company_profiles、contracts、subscriptions、payments、refresh_tokens 为主集合，不再建议继续使用旧的 users / orders 命名。"
}
