APP_NAME=MornContract
NEXT_PUBLIC_DEPLOYMENT_REGION=INTL
# Deprecated compatibility vars (remove after migration window):
# APP_REGION=INTL
# NEXT_PUBLIC_APP_REGION=INTL

APP_URL=https://www.mornhub.quest
NEXT_PUBLIC_APP_URL=https://www.mornhub.quest
NEXT_PUBLIC_SITE_URL=https://www.mornhub.quest
NEXT_PUBLIC_APP_DOMAIN=www.mornhub.quest

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=replace-with-long-random-64-plus-char-secret

# Google OAuth infra manifest (preferred over ad-hoc dashboard changes).
SUPABASE_GOOGLE_OAUTH_MANAGED=true
SUPABASE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
SUPABASE_GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
SUPABASE_GOOGLE_OAUTH_CALLBACK_URL=https://www.mornhub.quest/auth/callback

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYPAL_CLIENT_ID=paypal_client_id_replace_me
PAYPAL_CLIENT_SECRET=paypal_client_secret_replace_me
PAYPAL_WEBHOOK_ID=paypal_webhook_id_replace_me
PAYPAL_SANDBOX=true

# INTL payment channels support Stripe + PayPal.

# SMTP settings for email delivery (used by app-side email flows).
# If INTL password reset is handled fully by Supabase Auth, configure SMTP in Supabase dashboard as well.
AUTH_EMAIL_SMTP_HOST=smtp.example.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_SECURE=true
AUTH_EMAIL_SMTP_USER=your-smtp-username
AUTH_EMAIL_SMTP_PASS=your-smtp-password
AUTH_EMAIL_FROM="MornContract <no-reply@example.com>"

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

DOMESTIC_SYSTEM_URL=https://morncontract.mornscience.top
INTERNATIONAL_SYSTEM_URL=https://www.mornhub.quest

AI_GENERATE_MAX_TOKENS=1400

AI_ANALYZE_TIMEOUT_MS=8000

AI_ANALYZE_SOFT_TIMEOUT_MS=8000
AI_ANALYZE_ROUTE_BUDGET_MS=10000

AI_PROVIDER_TIMEOUT_MS=12000

AI_ANALYZE_INPUT_MAX_CHARS=3000

AI_GENERATE_TIME_BUDGET_MS=10000

AI_GENERATE_SOFT_TIMEOUT_MS=8000
AI_GENERATE_ROUTE_BUDGET_MS=10000
AI_CHAT_SOFT_TIMEOUT_MS=7000
AI_CHAT_ROUTE_BUDGET_MS=9000
OCR_SOFT_TIMEOUT_MS=7000
OCR_ROUTE_BUDGET_MS=9000
OCR_PROVIDER_TIMEOUT_MS=10000
CONTRACTS_LIST_TIMEOUT_MS=7000
CONTRACTS_CREATE_TIMEOUT_MS=8000
CONTRACTS_QUOTA_TIMEOUT_MS=5000
CONTRACTS_QUERY_TIMEOUT_MS=5000
CONTRACTS_ENQUEUE_TIMEOUT_MS=7000

AI_ANALYZE_MAX_TOKENS=900

MEMBERSHIP_PROFILE_TIMEOUT_MS=4000

AUTH_VERIFY_TIMEOUT_MS=5000

MEMBERSHIP_SETTINGS_TIMEOUT_MS=4000
