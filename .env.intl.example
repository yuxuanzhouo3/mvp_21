APP_NAME=MornContract
APP_REGION=INTL
NEXT_PUBLIC_APP_REGION=INTL
NEXT_PUBLIC_DEPLOYMENT_REGION=INTL

APP_URL=https://www.mornhub.quest
NEXT_PUBLIC_APP_URL=https://www.mornhub.quest
NEXT_PUBLIC_SITE_URL=https://www.mornhub.quest
NEXT_PUBLIC_APP_DOMAIN=www.mornhub.quest

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=replace-with-long-random-64-plus-char-secret

# Google login is configured in Supabase Auth > Providers.

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# INTL payment channels are Stripe-only in current configuration.

# SMTP settings for email delivery (used by app-side email flows).
# If INTL password reset is handled fully by Supabase Auth, configure SMTP in Supabase dashboard as well.
AUTH_EMAIL_SMTP_HOST=smtp.example.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_SECURE=true
AUTH_EMAIL_SMTP_USER=your-smtp-username
AUTH_EMAIL_SMTP_PASS=your-smtp-password
AUTH_EMAIL_FROM="MornContract <no-reply@example.com>"

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

DOMESTIC_SYSTEM_URL=https://morncontract.mornscience.top
INTERNATIONAL_SYSTEM_URL=https://www.mornhub.quest
