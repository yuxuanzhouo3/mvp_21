APP_NAME=MornContract
APP_REGION=CN
NEXT_PUBLIC_APP_REGION=CN
NEXT_PUBLIC_DEPLOYMENT_REGION=CN

APP_URL=https://morncontract.mornscience.top
NEXT_PUBLIC_APP_URL=https://morncontract.mornscience.top
NEXT_PUBLIC_SITE_URL=https://morncontract.mornscience.top
NEXT_PUBLIC_APP_DOMAIN=morncontract.mornscience.top

NEXT_PUBLIC_WECHAT_CLOUDBASE_ID=your-cloudbase-env-id
CLOUDBASE_SECRET_ID=your-cloudbase-secret-id
CLOUDBASE_SECRET_KEY=your-cloudbase-secret-key

JWT_SECRET=replace-with-long-random-64-plus-char-secret

# CN login methods: email/password + SMS verification (Tencent SMS).
TENCENT_SMS_APP_ID=your-tencent-sms-app-id
TENCENT_SMS_SIGN_NAME=your-tencent-sms-sign-name
TENCENT_SMS_TEMPLATE_ID=your-tencent-sms-template-id
TENCENT_SMS_SECRET_ID=your-tencent-sms-secret-id
TENCENT_SMS_SECRET_KEY=your-tencent-sms-secret-key
TENCENT_SMS_REGION=ap-guangzhou
AUTH_EMAIL_SMTP_HOST=smtp.example.com
AUTH_EMAIL_SMTP_PORT=465
AUTH_EMAIL_SMTP_SECURE=true
AUTH_EMAIL_SMTP_USER=your-smtp-username
AUTH_EMAIL_SMTP_PASS=your-smtp-password
AUTH_EMAIL_FROM="MornContract <no-reply@example.com>"

# WeChat login is removed; the following APP_ID is for WeChat Pay only.
WECHAT_APP_ID=your-wechat-pay-app-id
NEXT_PUBLIC_WECHAT_APP_ID=your-wechat-pay-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

WECHAT_PAY_MCH_ID=your-wechat-pay-mch-id
WECHAT_PAY_API_V3_KEY=replace-with-32-character-api-v3-key
WECHAT_PAY_API_KEY_V3=replace-with-32-character-api-v3-key
WECHAT_PAY_SERIAL_NO=your-wechat-pay-serial-no
WECHAT_PAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-your-wechat-pay-private-key\n-----END PRIVATE KEY-----"

ALIPAY_APP_ID=your-alipay-app-id
ALIPAY_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nreplace-with-your-alipay-private-key\n-----END RSA PRIVATE KEY-----
ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-your-alipay-public-key\n-----END PUBLIC KEY-----
ALIPAY_ALIPAY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-your-alipay-platform-public-key\n-----END PUBLIC KEY-----
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_CERT_MODE=false
# ALIPAY_APP_CERT=-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----
# ALIPAY_ALIPAY_PUBLIC_CERT=-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----
# ALIPAY_ALIPAY_ROOT_CERT=-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----

DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DOMESTIC_SYSTEM_URL=https://morncontract.mornscience.top
INTERNATIONAL_SYSTEM_URL=https://www.mornhub.quest

AI_GENERATE_MAX_TOKENS=1400

AI_ANALYZE_TIMEOUT_MS=8000

AI_ANALYZE_SOFT_TIMEOUT_MS=8000
AI_ANALYZE_ROUTE_BUDGET_MS=10000

AI_PROVIDER_TIMEOUT_MS=12000

AI_ANALYZE_INPUT_MAX_CHARS=3000

AI_GENERATE_TIME_BUDGET_MS=10000

AI_GENERATE_SOFT_TIMEOUT_MS=8000
AI_GENERATE_ROUTE_BUDGET_MS=10000
AI_CHAT_SOFT_TIMEOUT_MS=7000
AI_CHAT_ROUTE_BUDGET_MS=9000
OCR_SOFT_TIMEOUT_MS=7000
OCR_ROUTE_BUDGET_MS=9000
OCR_PROVIDER_TIMEOUT_MS=10000
CONTRACTS_LIST_TIMEOUT_MS=7000
CONTRACTS_CREATE_TIMEOUT_MS=8000
CONTRACTS_QUOTA_TIMEOUT_MS=5000
CONTRACTS_QUERY_TIMEOUT_MS=5000
CONTRACTS_ENQUEUE_TIMEOUT_MS=7000

AI_ANALYZE_MAX_TOKENS=900

MEMBERSHIP_PROFILE_TIMEOUT_MS=4000

AUTH_VERIFY_TIMEOUT_MS=5000

MEMBERSHIP_SETTINGS_TIMEOUT_MS=4000
